// Este proyecto usa Prettier (.prettierrc) y ESLint, no Biome.
// Anula el formatter global de Zed para evitar reformateos masivos.
{
  "languages": {
    "TypeScript": {
      "language_servers": ["vtsls", "eslint"],
      "formatter": "prettier",
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "JavaScript": {
      "language_servers": ["vtsls", "eslint"],
      "formatter": "prettier",
      "format_on_save": "on"
    },
    "JSON": {
      "formatter": "prettier"
    },
    "Prisma": {
      "format_on_save": "on"
    }
  }
}
