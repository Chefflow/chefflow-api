# ============================================
# TEST DATABASE - loaded by jest-e2e via globalSetup
# ============================================
# Points at the postgres-test container in docker-compose.yml (port 5433).
# This DB is ephemeral (tmpfs-backed) and is wiped between e2e runs.
# NEVER point this at your dev DB — the e2e suite calls deleteMany() on all
# tables and would erase your work.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/chefflow_test?schema=public"

TEST_DATABASE_USER="postgres"
TEST_DATABASE_PASSWORD="postgres"
TEST_POSTGRES_DB="chefflow_test"
TEST_POSTGRES_PORT=5433

NODE_ENV="test"
JWT_SECRET="test-jwt-secret-not-for-production"
JWT_REFRESH_SECRET="test-jwt-refresh-secret-not-for-production"
JWT_EXPIRES_IN="15m"
FRONTEND_URL="http://localhost:3000/"
ALLOWED_ORIGINS="http://localhost:3000"
FORCE_CROSS_ORIGIN_COOKIES=false
THROTTLE_TTL=60000
THROTTLE_LIMIT=1000
GOOGLE_CLIENT_ID="test-client-id"
GOOGLE_CLIENT_SECRET="test-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"
